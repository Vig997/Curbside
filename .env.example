NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional — canonical URL for Open Graph / metadata (e.g. https://your-app.vercel.app)
# NEXT_PUBLIC_SITE_URL=

# Optional — show demo IV spots on the map in production (default: off in production, on in dev)
# NEXT_PUBLIC_ENABLE_DEMO_SPOTS=true

# Optional — error monitoring (see docs/MONITORING.md)
# SENTRY_DSN=
